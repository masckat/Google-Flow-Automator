{
  "manifest_version": 3,
  "name": "Flow Storyboard Automator",
  "version": "1.6.2",
  "description": "Automate bulk image & video generation on Google Flow — queue storyboard prompts, manage character references, and auto-download results.",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow Storyboard Automator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*",
        "https://*.labs.google/*"
      ],
      "js": [
        "recap-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*",
        "https://*.labs.google/*"
      ],
      "js": [
        "vendor/wm-detect.js",
        "wm.js",
        "flow-inject.js"
      ],
      "css": [
        "flow-inject.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
